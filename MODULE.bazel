# Bazel (bzlmod) build configuration for the Go backend.
#
# This is the CI-verified build path: the .github/workflows/bazel.yml job installs
# bazelisk and runs `bazel build //... && bazel test //...`. Bazel is not installed
# in the local dev environment, so the local path is `go build/test` (see Makefile);
# the two paths build the same Go packages.
module(
    name = "groundstation_console",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.39.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
# Pin a Go SDK that rules_go 0.50.1 supports. The module targets go 1.23 (the
# code uses no newer stdlib), so this matches go.mod and keeps the whole Bazel
# toolchain (Bazel 7.4.1 + rules_go 0.50.1 + Go 1.23) on one known-good matrix.
go_sdk.download(version = "1.23.1")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_klauspost_compress",
    "com_github_pierrec_lz4_v4",
    "com_github_twmb_franz_go",
    "com_github_twmb_franz_go_pkg_kmsg",
)
