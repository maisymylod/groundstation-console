{
  "uid": "heliosnet-console-slo",
  "title": "groundstation-console - SLO",
  "tags": ["heliosnet", "groundstation-console", "slo"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Availability (rolling 30d)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.995 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(rate(console_requests_total{status=~\"5..\"}[30d])) / sum(rate(console_requests_total[30d])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error-budget remaining",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((sum(rate(console_requests_total{status=~\"5..\"}[30d])) / sum(rate(console_requests_total[30d]))) / (1 - 0.995))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Fleet-summary latency (p50 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum(rate(console_request_duration_seconds_bucket{route=\"/api/fleet\"}[5m])) by (le)) * 1000"
        },
        {
          "refId": "B",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum(rate(console_request_duration_seconds_bucket{route=\"/api/fleet\"}[5m])) by (le)) * 1000"
        }
      ]
    },
    {
      "id": 4,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{route}}",
          "expr": "sum(rate(console_requests_total[5m])) by (route)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Open incidents by anomaly type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{type}}",
          "expr": "sum(console_open_incidents) by (type)"
        }
      ]
    }
  ]
}
